# Copia este archivo como .env.local (en tu computadora) o pon cada variable en Vercel
# (Settings → Environment Variables). Nunca subas este archivo con valores reales a GitHub.

# La clave con la que entra tu agente (encabezado Authorization: Bearer) y tú en el navegador.
CLAVE_AGENTE=

# Dónde se guardan los datos, en este orden:
#  1. Convex (CONVEX_URL): base de datos en la nube, el paso opcional de LEEME.md.
#  2. Vercel Blob (BLOB_READ_WRITE_TOKEN): Vercel la pone sola al desplegar con el botón de LEEME.md
#     o al agregar un store de Blob en tu proyecto (Storage → Create Database → Blob). No la escribas a mano.
#  3. Si no hay ninguna: el archivo datos/datos.json de esta carpeta (en Vercel se borra seguido).
CONVEX_URL=
BLOB_READ_WRITE_TOKEN=

# La dirección pública de tu panel, sin diagonal al final. Google y Microsoft regresan aquí
# después de dar permiso: https://tu-panel.vercel.app (en tu computadora: http://localhost:3000)
APP_URL=

# ── Google (Gmail + Google Calendar) ──
# Se crean en console.cloud.google.com → APIs y servicios → Credenciales → ID de cliente de OAuth (Aplicación web).
# URI de redirección: APP_URL + /api/conexiones/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft 365 (Outlook + Calendario) ──
# Se crean en portal.azure.com → App registrations. Redirect URI (Web): APP_URL + /api/conexiones/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ── WhatsApp Business (Meta) ──
# developers.facebook.com → tu app → WhatsApp. El token permanente se genera con un "system user".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Una palabra secreta que tú inventas; se pone igual en Meta al registrar el webhook
# (URL del webhook: APP_URL + /api/conexiones/whatsapp/webhook).
WHATSAPP_VERIFY_TOKEN=

# Opcional. Zona horaria para los eventos de todo el día (vienen sin hora). Por defecto: America/Mexico_City
# ZONA_HORARIA=America/Mexico_City
